{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["employee", "admin", "head-procurement", "finance", "super-admin"] },
        "phone": { "type": "string" },
        "position": { "type": "string" },
        "vehicleNumber": { "type": "string" },
        "avatarColor": { "type": "string" },
        "themePreference": { "type": "string", "enum": ["dark", "high-contrast"] },
        "username": { "type": "string" },
        "authEmail": { "type": "string", "description": "Firebase Authentication account currently allowed to sign in as this person (passwords live in Firebase Authentication, never in Firestore)" }
      },
      "required": ["id", "name", "email", "role", "phone", "position", "avatarColor"]
    },
    "Shift": {
      "title": "Shift",
      "description": "Work shift",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "type": { "type": "string", "enum": ["normal", "on-call", "night", "off"] },
        "notes": { "type": "string" }
      },
      "required": ["id", "userId", "date", "startTime", "endTime", "type"]
    },
    "ClockLog": {
      "title": "ClockLog",
      "description": "A single clock-in/clock-out record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "clockInTime": { "type": "string" },
        "clockOutTime": { "type": "string" },
        "clockInGps_lat": { "type": "number" },
        "clockInGps_lng": { "type": "number" },
        "clockInGps_address": { "type": "string" },
        "clockOutGps_lat": { "type": "number" },
        "clockOutGps_lng": { "type": "number" },
        "clockOutGps_address": { "type": "string" },
        "totalHours": { "type": "number" },
        "overtimeHours": { "type": "number" },
        "calculatedPay": { "type": "number" },
        "verified": { "type": "boolean" },
        "notes": { "type": "string" }
      },
      "required": ["id", "userId", "userName", "clockInTime", "clockInGps_lat", "clockInGps_lng", "clockInGps_address", "verified"]
    },
    "Job": {
      "title": "Job",
      "description": "Job ticket",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string", "enum": ["maintenance", "general-supply", "urgent"] },
        "assignedUserId": { "type": "string" },
        "assignedUserName": { "type": "string" },
        "locationName": { "type": "string" },
        "gps_lat": { "type": "number" },
        "gps_lng": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "on-site", "in-progress", "completed"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "startedAt": { "type": "string" },
        "completedAt": { "type": "string" },
        "signature": { "type": "string" },
        "payoutAmount": { "type": "number" },
        "credited": { "type": "boolean", "description": "Payout already added to the technician balance" }
      },
      "required": ["id", "title", "description", "category", "assignedUserId", "assignedUserName", "locationName", "gps_lat", "gps_lng", "status", "priority", "payoutAmount"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string" },
        "recipientUserId": { "type": "string", "description": "A user id, \"all\", or \"admins\"" },
        "recipientUserName": { "type": "string" },
        "isSent": { "type": "boolean" },
        "type": { "type": "string", "enum": ["alert", "system", "job", "payroll"] }
      },
      "required": ["id", "title", "message", "timestamp", "recipientUserId", "recipientUserName", "isSent", "type"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A chat message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderRole": { "type": "string" },
        "recipientId": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "senderId", "senderName", "senderRole", "recipientId", "content", "timestamp"]
    },
    "Balance": {
      "title": "Balance",
      "description": "Pay owed to one person, kept apart from the staff directory",
      "type": "object",
      "properties": {
        "balanceDue": { "type": "number" },
        "lastCreditedJobId": { "type": "string" }
      },
      "required": ["balanceDue"]
    },
    "Username": {
      "title": "Username",
      "description": "Sign-in lookup: lower-case surname to account email",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["userId", "email"]
    },
    "StaffPassword": {
      "title": "StaffPassword",
      "description": "Readable copy of a person's password for the CEO's view (Super Admin only)",
      "type": "object",
      "properties": {
        "password": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["password"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Collection of all users"
    },
    "/shifts/{shiftId}": {
      "schema": { "$ref": "#/entities/Shift" },
      "description": "Collection of all user shifts"
    },
    "/clockLogs/{logId}": {
      "schema": { "$ref": "#/entities/ClockLog" },
      "description": "Collection of time entries"
    },
    "/jobs/{jobId}": {
      "schema": { "$ref": "#/entities/Job" },
      "description": "Collection of jobs/tickets"
    },
    "/notifications/{notifId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Collection of notifications"
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Collection of all chat messages"
    },
    "/balances/{userId}": {
      "schema": { "$ref": "#/entities/Balance" },
      "description": "Pay owed per person (readable by that person and payroll roles)"
    },
    "/usernames/{username}": {
      "schema": { "$ref": "#/entities/Username" },
      "description": "Sign-in lookup by lower-case surname"
    },
    "/staffPasswords/{userId}": {
      "schema": { "$ref": "#/entities/StaffPassword" },
      "description": "Readable passwords, only the Super Admin can read them"
    }
  }
}
