{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Vector",
  "version": "1.0.0",
  "identifier": "com.vectortechnical.portal",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Vector Technical",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "zoomHotkeysEnabled": true,
        "theme": "Dark",
        "backgroundColor": "#0A0A0A"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.firebaseapp.com; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; frame-src https://*.firebaseapp.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Vector Technical",
    "copyright": "© 2026 Vector Group. All rights reserved.",
    "category": "Business",
    "shortDescription": "Vector Technical maintenance & operations portal",
    "longDescription": "Field operations portal for Vector Technical Maintenance & General Supplies: job dispatch, rota scheduling, clock-in logs, contractor payouts, alerts and team chat, kept in sync across every phone and computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug",
      "minSdkVersion": 24
    }
  }
}
